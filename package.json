{
  "name": "@xyb-community/endometrial-workbench",
  "version": "0.3.2",
  "description": "面向子宫内膜癌患者与照护者的本机病程资料、FIGO 2023 分子分型、Lynch 家系、保育治疗决策、出血日志与放疗后私密记录工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "public",
    "src",
    "demo/build-demo-data.mjs",
    "demo/seed-demo-sqlite.mjs",
    "schema",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "ENDO_CHANNEL=beta node scripts/build-version.mjs && node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs && node scripts/build-client.mjs --check && node scripts/check-version.mjs && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-demo-columns.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-conformance.mjs . && node scripts/check-stage-consistency.mjs && node scripts/check-trial-matching.mjs .",
    "audit": "node scripts/check-conformance.mjs .",
    "build:version": "ENDO_CHANNEL=beta node scripts/build-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "release:check": "npm run check && npm run audit",
    "pack:check": "npm pack --dry-run",
    "check:pack": "node --disable-warning=ExperimentalWarning scripts/check-pack.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:columns": "node scripts/check-demo-columns.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:stage": "node scripts/check-stage-consistency.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "probe:proto": "node scripts/probe-proto.mjs",
    "probe:primer": "node scripts/probe-disease-primer.mjs",
    "probe:resp": "node scripts/probe-responsive.mjs",
    "check:hvt": "node scripts/check-hvt.mjs",
    "probe:headless": "node --disable-warning=ExperimentalWarning scripts/probe-headless.mjs",
    "probe:install": "node scripts/probe-install.mjs",
    "shots:readme": "node scripts/shots-readme.mjs",
    "demo:build": "node demo/build-demo-data.mjs",
    "demo:data": "node demo/build-demo-data.mjs",
    "verify:m2": "node demo/build-demo-data.mjs && node scripts/probe-proto.mjs && node scripts/probe-responsive.mjs && node scripts/check-hvt.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/endometrial-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
